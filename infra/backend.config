# State lives in R2, bucket `tfstates`, one prefix per repository, next to
# lonkar.org/infra.tfstate. The endpoint and the credentials are not here:
# scripts/terraform.sh passes them as -backend-config flags, from secrets in CI
# and from infra/.env.local here, the same as lonkar-org/lonkar.org.
#
# The skips are what an S3 backend needs to talk to something that is not S3:
# R2 has no IMDS, no STS, no account id endpoint, and one region called auto.
bucket                      = "tfstates"
key                         = "lonkar-org.github.io/infra.tfstate"
region                      = "auto"
encrypt                     = "1"
use_lockfile                = true
use_path_style              = true
skip_credentials_validation = true
skip_metadata_api_check     = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_s3_checksum            = true
